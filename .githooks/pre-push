#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

needs_verify=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac

  if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
    echo "pre-push blocked: verify the ref from the checked-out worktree (HEAD=$local_sha required)" >&2
    exit 1
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="$(git rev-list --max-parents=0 "$local_sha" | tail -n 1)"
  else
    base="$remote_sha"
  fi
  # Re-run the source-quality policy over the exact range being published.
  # This catches asm wrappers, barriers, and register pins even when a commit
  # was created outside the normal local hook path.
  python3 tools/check_decomp_policy.py --range "$base" "$local_sha" --check
  if python3 tools/check_decomp_policy.py --range "$base" "$local_sha" --needs-verification; then
    needs_verify=1
  fi
done

if [ "$needs_verify" -eq 0 ]; then
  exit 0
fi

python3 tools/check_decomp_policy.py --worktree --dirty-rom-paths
receipt="$(mktemp "${TMPDIR:-/tmp}/warioware-pre-push.XXXXXX.json")"
trap 'rm -f "$receipt"' EXIT
python3 tools/decomp_cycle.py verify --no-report --output "$receipt"
