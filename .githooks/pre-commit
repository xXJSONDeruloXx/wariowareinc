#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

python3 tools/check_decomp_policy.py --staged --check

# A commit must identify exactly which ROM-affecting work is staged. An
# unstaged source/linker edit would make the later working-tree push gate prove
# the wrong tree, so reject that ambiguity here.
unstaged_rom="$(git diff --name-only --diff-filter=ACMRTUXB)"
if [ -n "$unstaged_rom" ]; then
  while IFS= read -r path; do
    case "$path" in
      src/*|asm/*|include/*|data/*|audio/*|graphics/*|Makefile|wariowareinc.ld|wariowareinc_modern.ld|undefined_syms.ld|tools/agbcc-swi.patch)
        echo "pre-commit blocked: unstaged ROM-affecting path: $path" >&2
        exit 1
        ;;
    esac
  done <<< "$unstaged_rom"
fi

# The full Docker ROM gate is intentionally owned by pre-push. Keeping this
# hook fast avoids compiling the same tree twice in the normal commit-then-push
# workflow; policy and staged/unstaged ROM-scope checks above still prevent
# ambiguous or forbidden commits.
